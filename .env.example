# MarineGuard Environment Configuration
# Copy this file to .env.local for local development overrides

# Backend API Configuration (FastAPI)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Firebase Authentication (Will be populated when Firebase project is connected)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Application Mode
VITE_ENABLE_MOCK_AUTH=true

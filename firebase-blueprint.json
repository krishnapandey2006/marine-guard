{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "entities": {
    "User": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["analyst", "investigator", "commander", "admin"] },
        "organization": { "type": "string" },
        "clearanceLevel": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "displayName", "role"]
    },
    "Analysis": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "operatorName": { "type": "string" },
        "filename": { "type": "string" },
        "fileSize": { "type": "number" },
        "sensorType": { "type": "string" },
        "acquisitionDate": { "type": "string" },
        "spillDetected": { "type": "boolean" },
        "confidenceScore": { "type": "number" },
        "estimatedAreaSqKm": { "type": "number" },
        "coordinates": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "filename", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile records containing account metadata, role, organization, and clearance level."
    },
    "/analyses/{analysisId}": {
      "schema": { "$ref": "#/entities/Analysis" },
      "description": "Satellite imagery analysis records containing detection metrics, coordinates, and analyst timestamps."
    }
  }
}
